`timescale 1 ps/ 1 ps
module Question2_vlg_sample_tst(
	A,
	ALU_Reset,
	B,
	Clock,
	Clock1,
	data_in,
	Enable_Decoder,
	FSM_Reset,
	Reset_A,
	Reset_B,
	sampler_tx
);
input [7:0] A;
input  ALU_Reset;
input [7:0] B;
input  Clock;
input  Clock1;
input  data_in;
input  Enable_Decoder;
input  FSM_Reset;
input  Reset_A;
input  Reset_B;
output sampler_tx;

reg sample;
time current_time;
always @(A or ALU_Reset or B or Clock or Clock1 or data_in or Enable_Decoder or FSM_Reset or Reset_A or Reset_B)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

