initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Question2_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] A;
reg ALU_Reset;
reg [7:0] B;
reg Clock;
reg Clock1;
reg data_in;
reg Enable_Decoder;
reg FSM_Reset;
reg Reset_A;
reg Reset_B;
// wires                                               
wire [3:0] id;
wire [7:0] opcode;
wire [0:6] R_first_four;
wire [0:6] R_last_four;
wire [7:0] result;
wire [0:6] sign;
wire [0:6] Student_Id;

wire sampler;                             

// assign statements (if any)                          
Question2 i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.ALU_Reset(ALU_Reset),
	.B(B),
	.Clock(Clock),
	.Clock1(Clock1),
	.data_in(data_in),
	.Enable_Decoder(Enable_Decoder),
	.FSM_Reset(FSM_Reset),
	.id(id),
	.opcode(opcode),
	.R_first_four(R_first_four),
	.R_last_four(R_last_four),
	.Reset_A(Reset_A),
	.Reset_B(Reset_B),
	.result(result),
	.sign(sign),
	.Student_Id(Student_Id)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b0;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b1;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b1;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b1;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b0;
end 
// A[ 1 ]
initial
begin
	A[1] = 1'b0;
end 
// A[ 0 ]
initial
begin
	A[0] = 1'b0;
end 

// ALU_Reset
initial
begin
	ALU_Reset = 1'b0;
end 
// B[ 7 ]
initial
begin
	B[7] = 1'b0;
end 
// B[ 6 ]
initial
begin
	B[6] = 1'b0;
end 
// B[ 5 ]
initial
begin
	B[5] = 1'b0;
end 
// B[ 4 ]
initial
begin
	B[4] = 1'b0;
end 
// B[ 3 ]
initial
begin
	B[3] = 1'b1;
end 
// B[ 2 ]
initial
begin
	B[2] = 1'b0;
end 
// B[ 1 ]
initial
begin
	B[1] = 1'b0;
end 
// B[ 0 ]
initial
begin
	B[0] = 1'b0;
end 

// Clock
initial
begin
	Clock = 1'b0;
	Clock = #40000 1'b1;
	# 20000;
	repeat(23)
	begin
		Clock = 1'b0;
		Clock = #20000 1'b1;
		# 20000;
	end
	Clock = 1'b0;
end 

// Clock1
initial
begin
	Clock1 = 1'b0;
	Clock1 = #40000 1'b1;
	Clock1 = #40000 1'b0;
	Clock1 = #40000 1'b1;
	Clock1 = #40000 1'b0;
	Clock1 = #40000 1'b1;
	# 40000;
	repeat(9)
	begin
		Clock1 = 1'b0;
		Clock1 = #40000 1'b1;
		# 40000;
	end
	Clock1 = 1'b0;
end 

// data_in
initial
begin
	data_in = 1'b0;
	data_in = #200000 1'b1;
	# 40000;
	repeat(9)
	begin
		data_in = 1'b0;
		data_in = #40000 1'b1;
		# 40000;
	end
	data_in = 1'b0;
end 

// Enable_Decoder
initial
begin
	Enable_Decoder = 1'b1;
end 

// FSM_Reset
initial
begin
	FSM_Reset = 1'b1;
end 

// Reset_A
initial
begin
	Reset_A = 1'b0;
end 

// Reset_B
initial
begin
	Reset_B = 1'b0;
end 

Question2_vlg_sample_tst tb_sample (
	.A(A),
	.ALU_Reset(ALU_Reset),
	.B(B),
	.Clock(Clock),
	.Clock1(Clock1),
	.data_in(data_in),
	.Enable_Decoder(Enable_Decoder),
	.FSM_Reset(FSM_Reset),
	.Reset_A(Reset_A),
	.Reset_B(Reset_B),
	.sampler_tx(sampler)
);

Question2_vlg_check_tst tb_out(
	.id(id),
	.opcode(opcode),
	.R_first_four(R_first_four),
	.R_last_four(R_last_four),
	.result(result),
	.sign(sign),
	.Student_Id(Student_Id),
	.sampler_rx(sampler)
);
endmodule

